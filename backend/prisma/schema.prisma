// Schema v2: see docs/database.md

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// Enums
// ==========================================

enum LandType {
  lowland
  upland
}

enum WaterSupply {
  rainfed
  seasonal_irrigation
  year_round
}

enum SoilTexture {
  clay
  loam
  sandy
}

enum InputMode {
  lab
  test_kit
}

enum NutrientLevel {
  low
  medium
  high
}

enum Nutrient {
  organic_matter
  nitrogen
  phosphorus
  potassium
}

// ==========================================
// Better Auth
// ==========================================

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String?
  image         String?
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]
  plots    Plot[]
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id           String    @id @default(uuid())
  accountId    String
  providerId   String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String?
  refreshToken String?
  idToken      String?
  expiresAt    DateTime?
  password     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ==========================================
// User data
// ==========================================

model Plot {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  areaRai      Float
  province     String
  landType     LandType
  waterSupply  WaterSupply
  soilTexture  SoilTexture
  targetCropId String?
  targetCrop   Crop?       @relation(fields: [targetCropId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  analyses SoilAnalysis[]

  @@index([userId])
}

model SoilAnalysis {
  id        String    @id @default(uuid())
  plotId    String
  plot      Plot      @relation(fields: [plotId], references: [id], onDelete: Cascade)
  inputMode InputMode
  sampledAt DateTime
  ph        Float

  // lab mode
  organicMatterPct Float?
  phosphorusMgKg   Float?
  potassiumMgKg    Float?

  // test_kit mode
  nitrogenLevel   NutrientLevel?
  phosphorusLevel NutrientLevel?
  potassiumLevel  NutrientLevel?

  notes     String?
  createdAt DateTime @default(now())

  @@index([plotId])
  @@index([sampledAt])
}

// ==========================================
// Master data (seeded, read-only for users)
// ==========================================

model Crop {
  id             String   @id @default(uuid())
  name           String   @unique
  nameTh         String
  scientificName String?
  category       String
  description    String?
  imageUrl       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  requirement      CropRequirement?
  fertilizerRates  FertilizerRate[]
  fertilizerStages FertilizerStage[]
  targetedByPlots  Plot[]

  @@index([name])
}

model CropRequirement {
  id                    String        @id @default(uuid())
  cropId                String        @unique
  crop                  Crop          @relation(fields: [cropId], references: [id], onDelete: Cascade)
  allowedLandTypes      LandType[]
  minWaterSupply        WaterSupply
  preferredTextures     SoilTexture[]
  phMin                 Float
  phMax                 Float
  phOptimal             Float
  minOrganicMatterLevel NutrientLevel
  minNitrogenLevel      NutrientLevel
  minPhosphorusLevel    NutrientLevel
  minPotassiumLevel     NutrientLevel
  source                String
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

model NutrientLevelThreshold {
  id       String        @id @default(uuid())
  nutrient Nutrient
  level    NutrientLevel
  min      Float?
  max      Float?
  unit     String
  source   String

  @@unique([nutrient, level])
}

model FertilizerRate {
  id        String        @id @default(uuid())
  cropId    String
  crop      Crop          @relation(fields: [cropId], references: [id], onDelete: Cascade)
  nutrient  Nutrient
  soilLevel NutrientLevel
  kgPerRai  Float
  source    String

  @@unique([cropId, nutrient, soilLevel])
}

model FertilizerStage {
  id                String @id @default(uuid())
  cropId            String
  crop              Crop   @relation(fields: [cropId], references: [id], onDelete: Cascade)
  order             Int
  nameTh            String
  nameEn            String
  daysAfterPlanting Int
  nitrogenShare     Float
  phosphorusShare   Float
  potassiumShare    Float
  source            String

  @@unique([cropId, order])
}

model LimeRate {
  id                     String      @id @default(uuid())
  soilTexture            SoilTexture
  phFrom                 Float
  phTo                   Float
  kgCaco3PerRaiPerPhUnit Float
  source                 String

  @@unique([soilTexture, phFrom])
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]
  analyses      SoilAnalysis[]
  favorites     FavoriteCrop[]
}

model Session {
  id          String      @id @default(uuid())
  expiresAt   DateTime
  token       String      @unique
  ipAddress   String?
  userAgent   String?
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Account {
  id           String    @id @default(uuid())
  accountId    String
  providerId   String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String?
  refreshToken String?
  idToken      String?
  expiresAt    DateTime?
  password     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Crop {
  id             String           @id @default(uuid())
  name           String           @unique
  nameTh         String
  scientificName String?
  category       String           // e.g., Grain, Vegetable, Fruit, Cash Crop
  description    String?
  imageUrl       String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  requirement    CropRequirement?
  recommendations Recommendation[]
  favoritedBy    FavoriteCrop[]

  @@index([name])
}

model CropRequirement {
  id                String   @id @default(uuid())
  cropId            String   @unique
  crop              Crop     @relation(fields: [cropId], references: [id], onDelete: Cascade)
  nitrogenMin       Float
  nitrogenMax       Float
  nitrogenOptimal   Float
  phosphorusMin     Float
  phosphorusMax     Float
  phosphorusOptimal Float
  potassiumMin      Float
  potassiumMax      Float
  potassiumOptimal  Float
  phMin             Float
  phMax             Float
  phOptimal         Float
  organicMatterMin  Float?
  organicMatterMax  Float?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model SoilAnalysis {
  id            String           @id @default(uuid())
  userId        String?
  user          User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  nitrogen      Float
  phosphorus    Float
  potassium     Float
  ph            Float
  organicMatter Float?
  moisture      Float?
  province      String?
  region        String?
  season        String?
  notes         String?
  createdAt     DateTime         @default(now())

  recommendations Recommendation[]
  uploadedReport  UploadedReport?

  @@index([userId])
  @@index([createdAt])
}

model Recommendation {
  id                     String       @id @default(uuid())
  soilAnalysisId         String
  soilAnalysis           SoilAnalysis @relation(fields: [soilAnalysisId], references: [id], onDelete: Cascade)
  cropId                 String
  crop                   Crop         @relation(fields: [cropId], references: [id], onDelete: Cascade)
  suitabilityScore       Float
  recommendationLevel    String       // Excellent, Good, Fair, Poor, Not Recommended
  nitrogenScore          Float
  phosphorusScore        Float
  potassiumScore         Float
  phScore                Float
  reasons                Json         // string[]
  improvementSuggestions Json         // string[]
  createdAt              DateTime     @default(now())

  @@index([soilAnalysisId])
  @@index([cropId])
  @@index([suitabilityScore])
}

model FavoriteCrop {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cropId    String
  crop      Crop     @relation(fields: [cropId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, cropId])
}

model UploadedReport {
  id             String        @id @default(uuid())
  soilAnalysisId String?       @unique
  soilAnalysis   SoilAnalysis? @relation(fields: [soilAnalysisId], references: [id], onDelete: SetNull)
  fileName       String?
  fileUrl        String
  fileType       String        // pdf, image
  fileSize       Int?
  ocrStatus      String        @default("pending") // pending, processing, completed, failed
  extractedData  Json?
  rawText        String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([soilAnalysisId])
  @@index([ocrStatus])
}

